<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_requisition_form" model="ir.ui.view">
        <field name="name">purchase.requisition.form.send</field>
        <field name="model">purchase.requisition</field>
        <field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_order_send" string="Send by Email" type="object"
                        class="btn-primary" invisible="state not in ('draft', 'sent')"/>
            </header>

            <!-- 19.0: gli stati sono draft, confirmed, done, cancel. Il 17.0
                 elencava in_progress, open e ongoing, che non esistono più, e
                 toccava state_blanket_order, che è stato rimosso. -->
            <field name="state" position="attributes">
                <attribute name="statusbar_visible">draft,sent,confirmed,done</attribute>
            </field>

            <button name="action_draft" position="attributes">
                <attribute name="invisible">state not in ('cancel', 'sent')</attribute>
            </button>
            <button name="action_confirm" position="attributes">
                <attribute name="invisible">state not in ('draft', 'sent')</attribute>
            </button>
            <button name="action_cancel" position="attributes">
                <attribute name="invisible">state not in ('draft', 'sent', 'confirmed')</attribute>
            </button>
        </field>
    </record>
</odoo>
